# Source dependencies not available from apt. Commits are the ones this package was tested with.
#   vcs import --recursive src < src/fastlio_slam_toolbox_amr/dependencies.repos
# livox_ros_driver2 also needs Livox-SDK2 installed first (see README).
repositories:
  FAST_LIO_ROS2:
    type: git
    url: https://github.com/Ericsii/FAST_LIO_ROS2.git
    version: 2fffc570a25d0df172720bac034fbdb6a13d2162
  livox_ros_driver2:
    type: git
    url: https://github.com/Livox-SDK/livox_ros_driver2.git
    version: 6b9356cadf77084619ba406e6a0eb41163b08039
